# Expense Tracker Backend Configuration
# Copy this file to .env and customize for production deployment

APP_NAME="Expense Tracker — Smart Personal Finance Management System"
DEVELOPER_CREDIT="Developed by Anil Biradar"
ENVIRONMENT="development"

# Database URL (SQLite for local dev, PostgreSQL for production e.g., postgresql://user:pass@localhost:5432/expense_tracker)
DATABASE_URL="sqlite:///./expense_tracker.db"

# Security & JWT Configuration
SECRET_KEY="change-this-super-secret-jwt-key-in-production-anil-biradar-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Optional AI API Key for Spending Insights (OpenAI or Gemini compatible)
# Core application works 100% without an API key via deterministic rule-based financial analysis fallback
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"
